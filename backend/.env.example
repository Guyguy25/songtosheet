# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-a-long-random-string
PUBLIC_BASE_URL=http://localhost:8000
# Configure only once Stripe is ready. Checkout is disabled until then.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Keep 1 for localhost, set 0 behind TLS when in production.
DEV_MODE=1
# No free trial: new accounts start with 0 credits.
DATA_DIR=./data