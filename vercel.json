{
  "version": 2,
  "framework": null,
  "functions": {
    "api/player-assets.js": {
      "includeFiles": "node_modules/{opensheetmusicdisplay/{LICENSE,build/opensheetmusicdisplay.min.js},@tonejs/midi/{LICENSE.md,build/Midi.js}}"
    }
  },
  "rewrites": [
    {
      "source": "/api/collect",
      "destination": "/api/health?route=collect"
    },
    {
      "source": "/api/admin/stats",
      "destination": "/api/health?route=stats"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/apercu",
      "destination": "/index.html"
    },
    {
      "source": "/choisir-instrument",
      "destination": "/index.html"
    },
    {
      "source": "/choisir-format",
      "destination": "/index.html"
    },
    {
      "source": "/generation",
      "destination": "/index.html"
    },
    {
      "source": "/connexion",
      "destination": "/index.html"
    },
    {
      "source": "/inscription",
      "destination": "/index.html"
    },
    {
      "source": "/legal",
      "destination": "/index.html"
    },
    {
      "source": "/tarifs",
      "destination": "/index.html"
    },
    {
      "source": "/upgrade",
      "destination": "/index.html"
    },
    {
      "source": "/fonctionnalites",
      "destination": "/index.html"
    },
    {
      "source": "/resultats",
      "destination": "/index.html"
    },
    {
      "source": "/faq",
      "destination": "/index.html"
    },
    {
      "source": "/youtube-en-partition",
      "destination": "/outils/youtube-en-partition.html"
    },
    {
      "source": "/tablature-guitare",
      "destination": "/outils/tablature-guitare.html"
    },
    {
      "source": "/partition-piano",
      "destination": "/outils/partition-piano.html"
    },
    {
      "source": "/mp3-en-partition",
      "destination": "/outils/mp3-en-partition.html"
    },
    {
      "source": "/spotify-en-partition",
      "destination": "/outils/spotify-en-partition.html"
    },
    {
      "source": "/deezer-en-partition",
      "destination": "/outils/deezer-en-partition.html"
    },
    {
      "source": "/musicxml",
      "destination": "/outils/musicxml.html"
    },
    {
      "source": "/midi",
      "destination": "/outils/midi.html"
    },
    {
      "source": "/en/youtube-to-sheet-music",
      "destination": "/outils/en/youtube-to-sheet-music.html"
    },
    {
      "source": "/en/guitar-tab-generator",
      "destination": "/outils/en/guitar-tab-generator.html"
    },
    {
      "source": "/en/piano-sheet-music",
      "destination": "/outils/en/piano-sheet-music.html"
    },
    {
      "source": "/en/mp3-to-sheet-music",
      "destination": "/outils/en/mp3-to-sheet-music.html"
    },
    {
      "source": "/en/spotify-to-sheet-music",
      "destination": "/outils/en/spotify-to-sheet-music.html"
    },
    {
      "source": "/en/deezer-to-sheet-music",
      "destination": "/outils/en/deezer-to-sheet-music.html"
    },
    {
      "source": "/en/musicxml",
      "destination": "/outils/en/musicxml.html"
    },
    {
      "source": "/en/midi",
      "destination": "/outils/en/midi.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/app",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/app/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/connexion",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/inscription",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/upgrade",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/apercu",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/choisir-instrument",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/choisir-format",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/generation",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/statistiques.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/comparatif.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/imprimer.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "songtosheet.vercel.app"
        }
      ],
      "destination": "https://tablurio.com/$1",
      "permanent": true
    },
    {
      "source": "/tt",
      "destination": "/?utm_source=tiktok&utm_medium=bio",
      "permanent": false
    },
    {
      "source": "/ig",
      "destination": "/?utm_source=instagram&utm_medium=bio",
      "permanent": false
    },
    {
      "source": "/outils/:slug.html",
      "destination": "/:slug",
      "permanent": true
    },
    {
      "source": "/outils/en/:slug.html",
      "destination": "/en/:slug",
      "permanent": true
    }
  ]
}
