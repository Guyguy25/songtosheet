{
  "version": 2,
  "framework": null,
  "functions": {
    "api/player-assets.js": {
      "includeFiles": "node_modules/{opensheetmusicdisplay/{LICENSE,build/opensheetmusicdisplay.min.js},@tonejs/midi/{LICENSE.md,build/Midi.js}}"
    }
  },
  "rewrites": [
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/apercu",
      "destination": "/index.html"
    },
    {
      "source": "/choisir-instrument",
      "destination": "/index.html"
    },
    {
      "source": "/choisir-format",
      "destination": "/index.html"
    },
    {
      "source": "/generation",
      "destination": "/index.html"
    },
    {
      "source": "/connexion",
      "destination": "/index.html"
    },
    {
      "source": "/inscription",
      "destination": "/index.html"
    },
    {
      "source": "/legal",
      "destination": "/index.html"
    },
    {
      "source": "/tarifs",
      "destination": "/index.html"
    },
    {
      "source": "/upgrade",
      "destination": "/index.html"
    },
    {
      "source": "/fonctionnalites",
      "destination": "/index.html"
    },
    {
      "source": "/resultats",
      "destination": "/index.html"
    },
    {
      "source": "/faq",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
