{
  "version": 2,
  "framework": null,
  "functions": {
    "api/player-assets.js": {
      "includeFiles": "node_modules/{opensheetmusicdisplay/{LICENSE,build/opensheetmusicdisplay.min.js},@tonejs/midi/{LICENSE.md,build/Midi.js}}"
    }
  },
  "rewrites": [
    {
      "source": "/api/collect",
      "destination": "/api/health?route=collect"
    },
    {
      "source": "/api/admin/stats",
      "destination": "/api/health?route=stats"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/apercu",
      "destination": "/index.html"
    },
    {
      "source": "/choisir-instrument",
      "destination": "/index.html"
    },
    {
      "source": "/choisir-format",
      "destination": "/index.html"
    },
    {
      "source": "/generation",
      "destination": "/index.html"
    },
    {
      "source": "/connexion",
      "destination": "/index.html"
    },
    {
      "source": "/inscription",
      "destination": "/index.html"
    },
    {
      "source": "/legal",
      "destination": "/index.html"
    },
    {
      "source": "/tarifs",
      "destination": "/index.html"
    },
    {
      "source": "/upgrade",
      "destination": "/index.html"
    },
    {
      "source": "/fonctionnalites",
      "destination": "/index.html"
    },
    {
      "source": "/resultats",
      "destination": "/index.html"
    },
    {
      "source": "/faq",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/app",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/app/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/connexion",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/inscription",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/upgrade",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/apercu",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/choisir-instrument",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/choisir-format",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/generation",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/statistiques.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/comparatif.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/imprimer.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "songtosheet.vercel.app"
        }
      ],
      "destination": "https://tablurio.com/$1",
      "permanent": true
    },
    {
      "source": "/tt",
      "destination": "/?utm_source=tiktok&utm_medium=bio",
      "permanent": false
    },
    {
      "source": "/ig",
      "destination": "/?utm_source=instagram&utm_medium=bio",
      "permanent": false
    }
  ]
}
