      "source": "/tt",
      "destination": "/?utm_source=tiktok&utm_medium=bio",
      "permanent": false
    },
    {
      "source": "/ig",
      "destination": "/?utm_source=instagram&utm_medium=bio",
      "permanent": false
    },
    {
      "source": "/outils/:slug.html",
      "destination": "/:slug",
      "permanent": true
    },
    {
      "source": "/outils/en/:slug.html",
      "destination": "/en/:slug",
      "permanent": true
    },
    {
      "source": "/outils/info/:path*",
