{
  "version": 2,
  "framework": null,
  "rewrites": [
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/apercu",
      "destination": "/index.html"
    },
    {
      "source": "/choisir-instrument",
      "destination": "/index.html"
    },
    {
      "source": "/generation",
      "destination": "/index.html"
    },
    {
      "source": "/connexion",
      "destination": "/index.html"
    },
    {
      "source": "/inscription",
      "destination": "/index.html"
    },
    {
      "source": "/legal",
      "destination": "/index.html"
    },
    {
      "source": "/tarifs",
      "destination": "/index.html"
    },
    {
      "source": "/fonctionnalites",
      "destination": "/index.html"
    },
    {
      "source": "/resultats",
      "destination": "/index.html"
    },
    {
      "source": "/faq",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
